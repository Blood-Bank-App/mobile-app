{
  "expo": {
    "name": "bloodbankapp",
    "slug": "bloodbankapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bloodbankapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.zutymesep.bloodbankapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "com.bloodbankapp.bloodbank",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://backend-python-backendproduction.up.railway.app/api",
      "socketUrl": "https://backend-python-backendproduction.up.railway.app",
      "stripePublishableKey": "pk_test_51PzfJqDLnthAVUMtvsLTh62plknX4r4wwVvykXKPkDaJbrDwtw3WUVsCctHfMfuioffOfdkwuleRPRI3ZsqNlPuz00HPUZ6h5f",
      "router": {},
      "eas": {
        "projectId": "43b389d4-4a04-481f-90a8-d219fe164fa9"
      }
    },
    "eas": {
      "projectId": "43b389d4-4a04-481f-90a8-d219fe164fa9"
    },
    "owner": "zutymesep",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "platforms": ["ios", "android"],
    "updates": {
      "url": "https://u.expo.dev/43b389d4-4a04-481f-90a8-d219fe164fa9"
    }
  }
}
