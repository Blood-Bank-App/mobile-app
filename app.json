{
  "expo": {
    "name": "upgrade53",
    "slug": "upgrade53",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "upgrade53",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "com.upgrade53.bloodbank",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "stripePublishableKey": "pk_test_51PzfJqDLnthAVUMtvsLTh62plknX4r4wwVvykXKPkDaJbrDwtw3WUVsCctHfMfuioffOfdkwuleRPRI3ZsqNlPuz00HPUZ6h5f",
      "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51PzfJqDLnthAVUMtvsLTh62plknX4r4wwVvykXKPkDaJbrDwtw3WUVsCctHfMfuioffOfdkwuleRPRI3ZsqNlPuz00HPUZ6h5f",
      "backendUrl": "https://backend-python-backendproduction.up.railway.app/api"
    }
  }
}
